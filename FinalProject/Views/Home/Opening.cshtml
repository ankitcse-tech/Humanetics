@using System.Data

@{
    ViewBag.Title = "Opening";
    Layout = "~/Views/Shared/_GeneralLayout.cshtml";
}

<div class="row ">
    <div class="col-sm-10 mx-auto">
        <div class="row py-2">
            <p class="fs-3 text-center fw-semibold">Our Current <b class="text-primary">Job Opening</b></p>
            <hr class="mx-auto w-30" />
        </div>
        <!--Start job opening section-->
        <div class="row">
            @foreach(DataRow row in ViewBag.opening.Rows)
            {
            <div class="col-sm-6">
                <!--Start Opening Card-->
                <div class="card text-center mb-2">
                    <div class="card-header">
                        <i class="fa-solid fa-calendar-days text-mycolor"></i> Posted on : @row["STARTDATE"]
                        <span class="badge text-bg-success text-light">@row["STATUS"]</span>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">@row["TITLE"]</h5>
                        <p class="card-text">@row["DETAILS"]</p>
                    </div>
                    <div class="row">
                        <div class="col-sm-4">Job Type : @row["JOBTYPE"]</div>
                        <div class="col-sm-4">City: @row["CITY"]</div>
                        <div class="col-sm-4">Shift: @row["SHIFT"]</div>
                        <div class="col-sm-4">Total Opening : @row["VACANCY"]</div>
                        <div class="col-sm-4">Salary : @row["MINSALARY"] to @row["MAXSALARY"]</div>
                        <div class="col-sm-4">Required Exp. : @row["EXP"]</div>
                    </div>
                    <div class="row">
                        Educatinal Qualification: @row["EDUCATION"]
                    </div>
                    <div>
                        <a href="/home/apply?JobId=@row["ID"]&title=@row["TITLE"]" class="btn btn-primary">Appy Now</a>

                    </div>
                    <div class="card-footer text-body-secondary">
                        <i class="fa-solid fa-calendar-days text-mycolor"></i> Expires on : @row["LASTDATE"]
                    </div>
                </div>
            </div>
            }
            <!--end Opening Card-->
        </div>
        <!--End job opening section-->
    </div>
</div>

