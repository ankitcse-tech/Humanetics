
@{
    ViewBag.Title = "Application";
    Layout = "~/Views/Shared/_GeneralLayout.cshtml";
}

<div class="row">
    <div class="col-sm-12">
        @*<p class="fs-3 text-center">
            Your Job Application <b class="text-mycolor">Status</b>
        </p>*@
        <p class="fs-3 text-center fw-semibold">
            Your Job Application<b class="text-primary"> Status</b><br />
            <span class="fs-5">Your Application Progress, Simplified</span>
            <hr class="w-25 mx-auto" />
        </p>
        <hr class="mx-auto w-30" />
    </div>
    <form method="get">
        <div class="row ">
            <div class="col-sm-10 shadow p-3 mb-5 bg-body rounded mt-5 mx-auto">           
                <div class="row">
                    <div class="col-sm-4">
                        <div class="form-floating mb-3 ">  
                            <input type="email" name="email" class="form-control" id="floatingto" placeholder="name@example.com" />
                            <label for="floatingto">Enter Your Email Id</label>
                        </div>
                    </div>

                    <div class="col-sm-2">
                            <input type="submit" class="btn btn-danger" value="View Report" />

                    </div>
                </div>
            </div>
        </div>
    </form>

    @if(ViewBag.app != null)
            {
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Apply On</th>
                            <th>Date</th>
                            <th>Is Hired</th>
                            <th>Is rejected</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(System.Data.DataRow row in ViewBag.app.Rows)
                        { 
                        <tr>
                            <td>@row["NAME"]</td>
                            <td>@row["JobID"]</td>
                            <td>@row["RegDate"]</td>
                            <td>@row["ISHIRED"]</td>
                            <td>@row["ISREJECTED"]</td>
                        </tr>
                        }
                    </tbody>
                </table>
    }

</div>
