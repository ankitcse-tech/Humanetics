<!DOCTYPE html>

    <html>
    <head>
        <meta name="viewport" content="width=device-width" />
        <title>@ViewBag.Title</title>
        <link href="~/Content/CSS/all.css"
              rel="stylesheet" />
        <link href="~/Content/CSS/bootstrap.min.css" rel="stylesheet" />
        <script src="~/Content/js/bootstrap.bundle.js"></script>
        <style>
            .bg-mycolor {
                background: #00ffff;
            }

            .text-mycolor {
                color: #00ffff !important;
                /*color: #5bf6d9 !important;*/
            }

            .header {
                min-height: 50px;
                padding-top: 10px;
            }

            .ic {
                font-size: 20px;
                height: 25px;
                width: 25px;
                text-align: center;
                line-height: 25px;
                border: 1px solid #00ffff;
                color: #00ffff;
                transition: .5s;
            }

                .ic:hover
                {
                    transform: rotate(360deg);
                    transition: 1.5s;
                    background: #00ffff;
                    color:white;
                }

            #menu ul li a {
                color: white;
                font-size: 10px;
            }

            .sliderimg {
                height: 600px;
            }

            .servicesimg {
                height: 150px;
            }

            .servicescard:hover {
                transform: scale(1.1);
                transition: 2s;
            }

            .servicescard {
                transition: 2s;
            }

            .ufooter {
                min-height: 200px;
            }

            .bfooter {
                height: 50px;
            }

            .fact {
                min-height: 250px;
            }

            .gallery {
                min-height: 300px;
            }

            .team {
                min-height: 300px;
            }
            .imgpic{
                height:200px;
            }
            .webtext{
                font-size:15px;
            }
            .txtname{
                line-height:50px;
            }
            .login{
                margin-top:100px;
                margin-bottom:100px;
            }
            .teamimg{
                height:400px;
                /*height:350;
                    perfect to your current image
                */
            }
            .imgservice{
                height:140px;
            }
            .serviceic{
                font-size:12px;
                color:#ff0000 !important;
            }
            .directorimg{
                height:400px;
            }
            .imgfeature {
                height: 80px;
            }
            .social-icons a {
                text-decoration:none;
                outline:none;
            }
        </style>
    </head>
    <body>
        <div class="container-fluid">
            <!--Start Header-->
            <div class="row header">
                <div class="col-sm-10 mx-auto">
                    <div class="row py-3">
                        <div class="col-sm-3 fs-4">
                            Huma<b class="text-mycolor">Netics<i class="fa-solid fa-graduation-cap "></i></b>
                        </div>
                        <div class="col-sm-3">
                            <b><i class="fa-solid fa-phone ic text-success"></i> Call Us</b> : <br />+91-8858832962
                        </div>
                        <div class="col-sm-3">
                            <b><i class="fa-solid fa-envelope ic text-danger"></i> Mail Us</b> : <br />
                            ankitmscollege@gamil.com
                        </div>
                        <div class="col-sm-3 pt-3 text-end social-icons">
                            <a href="https://www.facebook.com/" target="_blank">
                                <i class="fa-brands fa-facebook-square ic text-primary"></i>
                            </a>
                            <a href="https://www.instagram.com/" target="_blank">
                                <i class="fa-brands fa-instagram-square ic text-danger"></i>
                            </a>
                            <a href="https://wa.me/" target="_blank">
                                <i class="fa-brands fa-whatsapp-square ic text-success"></i>
                            </a>
                            <a href="https://twitter.com/" target="_blank">
                                <i class="fa-brands fa-twitter-square ic text-primary"></i>
                            </a>
                        </div>
                    </div>
                </div>             
            </div>
            <!--End Header-->
            <!--Start Menu-->
            <div class="row bg-mycolor shadow-lg" @*style="position:sticky !important; top:0px !important"*@>
                <div class="col-sm-10 mx-auto p-0">
                    <nav class="navbar navbar-expand-lg">
                        <div class="container-fluid">

                            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                                <span class="navbar-toggler-icon"></span>
                            </button>
                            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                                <div id="menu" class="mx-auto">
                                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                                        <li class="nav-item">
                                            <a class="nav-link active" aria-current="page" href="/home/index"><i class="fa-solid fa-house text-primary"></i> Home</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" href="/home/about"><i class="fa-solid fa-address-card text-primary"></i> About Us</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" href="/home/services"><i class="fa-solid fa-address-card text-primary"></i> Services</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" href="/home/contact"><i class="fa-solid fa-phone text-primary"></i> Contact Us</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" href="/home/team"><i class="fa-solid fa-people-group text-primary"></i> Our Team</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" href="/home/opening"><i class="fa fa-bullhorn text-primary"></i> Current Opening</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" href="/home/apply"><i class="fa fa-file-alt text-primary"></i> Apply for Job</a>
                                        </li>
                                        <li class="nav-item dropdown">
                                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fa-solid fa-key text-primary"></i> Login
                                            </a>
                                            <ul class="dropdown-menu">
                                                <li><a class="dropdown-item text-mycolor" href="/home/login"><i class="fa-solid fa-key text-primary"></i> Admin Login</a></li>
                                                <li><a class="dropdown-item text-mycolor" href="/home/emplogin"><i class="fa-solid fa-key text-primary"></i> Employee Login</a></li>
                                            </ul>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" href="/home/application"><i class="fa fa-laptop-file text-primary"></i> My Application</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
            </div>

            <!--End Menu-->
        </div>
        <div style="min-height:700px;" >
            @RenderBody()
        </div>
        <!--ufooter Start-->
        <div class="container-fluid bg-dark">
            <div class="row ufooter">
                <div class="col-sm-10 mx-auto">
                    <div class="row">
                        <div class="col-sm-3 p-3 text-light">
                            <p class="fs-5">Contact Address :</p>
                            <p>Jaunpur 222143, Uttar Pradesh, INDIA</p>
                            <br />
                            <span><i class="fa-solid fa-phone text-primary"></i>+91-8858832962</span>
                            <br />
                            <span><i class="fa-solid fa-phone text-primary"></i>+91-8577832962</span>
                            <br />
                            <span><i class="fa-solid fa-envelope text-primary"></i> info-@@humanetics.com</span>
                            <div class="col-sm-4 text-center social-icons">
                                <a href="https://www.facebook.com/" target="_blank">
                                    <i class="fa-brands fa-facebook-square ic text-primary"></i> 
                                </a>
                                <a href="https://www.instagram.com/" target="_blank">
                                    <i class="fa-brands fa-instagram-square ic text-danger"></i>
                                </a>
                                <a href="https://wa.me/" target="_blank">
                                    <i class="fa-brands fa-whatsapp-square ic text-success"></i>
                                </a>
                                <a href="https://twitter.com/" target="_blank">
                                    <i class="fa-brands fa-twitter-square ic text-primary"></i>
                                </a>
                            </div>
                        </div>
                        <div class="col-sm-3 p-3 text-light">
                            <p class="footermenu"><i class="fa-solid fa-chevron-right"></i><a class="text-decoration-none" href="/home/team">Team</a></p>
                            <p class="footermenu text-decoration-none"><i class="fa-solid fa-angle-right"></i><a class="text-decoration-none" href="/home/index">Home</a></p>
                            <p class="footermenu"><i class="fa-solid fa-chevron-right"></i><a class="text-decoration-none" href="#">Gallery</a></p>
                            <p class="footermenu"><i class="fa-solid fa-chevron-right"></i><a class="text-decoration-none" href="#">Services</a></p>
                            <p class="footermenu"><i class="fa-solid fa-chevron-right"></i><a class="text-decoration-none" href="/home/about">About Us</a></p>
                        </div>
                        <div class="col-sm-3 p-3 text-light">
                            <p class="footermenu text-decoration-none"><i class="fa-solid fa-chevron-right"></i><a class="text-decoration-none" href="#">Careers</a></p>
                            <p class="footermenu"><i class="fa-solid fa-chevron-right"></i><a class="text-decoration-none" href="#">Contact Us</a></p>
                            <p class="footermenu"><i class="fa-solid fa-chevron-right"></i><a class="text-decoration-none" href="#">Privacy Policy</a></p>
                            <p class="footermenu"><i class="fa-solid fa-chevron-right"></i><a class="text-decoration-none" href="#">Help & Support</a></p>
                            <p class="footermenu"><i class="fa-solid fa-chevron-right"></i><a class="text-decoration-none" href="#">Terms & Conditions</a></p>
                        </div>
                        <div class="col-sm-3 p-3 text-light">
                            <p class="fs-5 fw-semibold">About Website</p>
                            <p class="webtext">
                                Smart Employee Management System helps manage employee records, job applications
                                and team collaboration efficiently with a user-friendly interface tailored for mordern
                                organizations.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--ufooter End-->
        <!--bfooter Start-->
        <div class="container-fluid">
            <div class="row bfooter bg-dark text-light text-center bfooter border-top border-light pt-3" >
                <div class="col-sm-6">Developed By : <b class="text-mycolor">Ankit Bind</b> </div>
                <div class="col-sm-6">
                    Copyright &copy; To: <b class="text-mycolor">HumaNetics Private Limited</b>
                </div>
            </div>
        </div>
        <!--bfooter End-->
    </body>
    </html>






