
@{
    ViewBag.Title = "Attendance Report";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="container-fluid">
    <form method="get">
        <div class="row ">
            <div class="col-sm-10 shadow p-3 mb-5 bg-body rounded mt-5 mx-auto">
                @*<h3>
            Employee Attendance Report
        </h3>*@
                <p class="fs-3 text-center fst-italic">
                    Employee<b class="text-mycolor"> Attendance Report</b>
                </p>
                <div class="row">
                    <div class="col-sm-4">
                        <div class="form-floating ">
                            <select class="form-select" name="email" id="floatingSelect" aria-label="Floating label select example">
                                <option selected>
                                    Select employee
                                </option>
                                @foreach (System.Data.DataRow row in ViewBag.employee.Rows)
                                {
                                    <option>@row["NAME"] @row["EMAILID"]</option>
                                }

                            </select>
                            <label for="floatingSelect">Select Employee</label>
                        </div>
                    </div>

                    <div class="col-sm-4">
                        <div class="form-floating mb-3">
                            <input type="date" class="form-control" name="fromdate" id="floatingfrom" placeholder="name@example.com" />
                            <label for="floatingfrom">From Date</label>

                        </div>
                    </div>

                    <div class="col-sm-4">
                        <div class="form-floating mb-3">
                            <input type="date" class="form-control" name="todate" id="floatingto" placeholder="name@example.com" />
                            <label for="floatingto">To Date</label>

                        </div>
                    </div>


                    <div class="col-sm-2">
                        <div class="form-floating mb-3">
                            <input type="submit" class="btn btn-danger" value="View Report" />

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>

    @if(ViewBag.attend != null)
    { 

    <span class="text-center fs-5 text-danger">
        Total : @ViewBag.attend.Rows.Count 20 Attendance found between @Request.QueryString["fromdate"] to @Request.QueryString["todate"]
    </span>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>SR</th>
                <th>Email ID</th>
                <th>Attendance Date</th>
                <th>Attendance Time</th>
                <th>Added On</th>
            </tr>
        </thead>
        <tbody>
            @foreach (System.Data.DataRow row in ViewBag.attend.Rows)
            { 
            <tr>
                <td>1</td>1
                <td>@row["EMPID"]</td>
                <td>@row["ADATE"]</td>
                <td>@row["ATIME"]</td>
                <td>@row["ADDEDON"]</td>
            </tr>
            }
        </tbody>
    </table>
    }
</div>