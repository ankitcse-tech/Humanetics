
@{
    ViewBag.Title = "Leaveapplication";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row py-2">
        <div class="col-sm-10 mx-auto">
            <p class="fs-3 text-center fst-italic">
                All Employee<b class="text-mycolor"> Leave Applications</b>
            </p>
            <hr class="mx-auto w-30" />
        </div>
        <div class="col-sm-12" style="overflow-x:scroll">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>SR</th>
                        <th>Employee ID</th>
                        <th>Subject</th>
                        <th>Details</th>
                        <th>From Date</th>
                        <th>To Date</th>
                        <th>Total Days</th>
                        <th>Applied On</th>
                        <th>Status</th>
                        <th>Attachment</th>
                        <th>Change Status</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1;}

                    @foreach (System.Data.DataRow row in ViewBag.leave.Rows)
                    {

                        <tr>
                            <td>@i</td>
                            <td>@row["EMPID"]</td>
                            <td>@row["TITLE"]</td>
                            <td>@row["DETAIL"]</td>
                            <td>@row["FROMDATE"]</td>
                            <td>@row["TODATE"]</td>
                            <td>@row["TOTALDAYS"]</td>
                            <td>@row["APPLIEDON"]</td>
                            @if (row["ISACCEPTED"] == DBNull.Value)
                            {
                                <td>
                                    <span class="badge bg-warning">Pending</span>
                                </td>
                            }
                            else if (Convert.ToBoolean(row["ISACCEPTED"]))
                            {
                                <td>
                                    <span class="badge bg-success">Accepted</span>
                                </td>
                            }
                            else
                            {
                                <td>
                                    <span class="badge bg-danger">Rejected</span>
                                </td>
                            }
                            <td><a href="~/Content/leavefile/@row["attachfile"]"><i class="fa-solid fa-download" text-primary></i></a></td>
                            <td>@row["ISACCEPTED"]</td>
                            <td>
                                @if (row["ISACCEPTED"] == DBNull.Value)
                                {
                                    <a href="/admin/acceptleave?id=@row["ID"]" onclick="return confirm('Do you really want to accept this leave application?')">
                                        <span class="btn btn-success text-left mx-auto pe-3">Accept</span>
                                    </a>
                                    <a href="/admin/rejectleave?id=@row["ID"]" onclick="return confirm('Do you really want to reject this leave application?')">
                                        <span class="btn btn-danger text-left me-5 pe-3">Reject</span>
                                    </a>
                                }
                            </td>
                        </tr>
                        i = i + 1;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

