
@{
    ViewBag.Title = "Attendance";
    Layout = "~/Views/Shared/_Employeelayout.cshtml";
}

<div class="container-fluid">
    <div class="row text-center mt-4 ">
        <div class="col-sm-12 text-center">
            @*<h3><span class="">Dear Employee! Please mark your Attandance for Today</span></h3>*@
            <span class="fs-3 text-center fw-semibold fst-italic">
              Dear Employee! <b class="text-mycolor"> Please mark your Attandance for Today </b>
             </span>
            <hr />
            <h4><span class="text-mycolor">Today Is: @DateTime.Now.ToShortDateString().</span>(@DateTime.Now.DayOfWeek)</h4>

            @if (ViewBag.data.Rows.Count > 0)
            {
                <h2 class="text-success">You are logged in at : @ViewBag.data.Rows[0]["ADDEDON"]</h2>
            }
            else
            {


                <form method="post">
                    <button type="submit" class="btn btn-lg btn-primary">
                        Mark Your Attendance
                    </button>
                </form>
            }
            <hr />
            <span><a>View Previous Attendance Report</a></span>
        </div>
    </div>
</div>
