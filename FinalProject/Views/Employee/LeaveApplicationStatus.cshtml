
@{
    ViewBag.Title = "LeaveApplicationStatus";
    Layout = "~/Views/Shared/_Employeelayout.cshtml";
}

<div class="container-fluid">
    <div class="row py-2">
        <div class="col-sm-10 mx-auto">
            <p class="fs-3 text-center fst-italic">
                All Your <b class="text-mycolor">Leave Applications</b>
            </p>
            <hr class="mx-auto w-30" />
        </div>
        <div class="col-sm-12" style="overflow-x:scroll">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>SR</th>
                        <th>Subject</th>
                        <th>Details</th>
                        <th>From Date</th>
                        <th>To Date</th>
                        <th>Total Days</th>
                        <th>Applied On</th>
                        <th>Status</th>
                        <th>Attachment</th>
                        <th>Value</th>
                        </tr>
                    </thead>
                <tbody>
                    @{ int i = 1;}
                    
                    @foreach (System.Data.DataRow row in ViewBag.leave.Rows)
                    {

                    <tr>
                        <td>@i</td>
                        <td>@row["TITLE"]</td>
                        <td>@row["DETAIL"]</td>
                        <td>@row["FROMDATE"]</td>
                        <td>@row["TODATE"]</td>
                        <td>@row["TOTALDAYS"]</td>
                        <td>@row["APPLIEDON"]</td>
                        @if (row["ISACCEPTED"] == DBNull.Value)
                        {
                            <td>
                                <span class="badge bg-warning">Pending</span>
                            </td>
                        }
                        else if (Convert.ToBoolean(row["ISACCEPTED"]))
                        {
                            <td>
                                <span class="badge bg-success">Accepted</span>
                            </td>
                        }
                        else
                {
                    <td>
                        <span class="badge bg-danger">Rejected</span>
                    </td>
                }
                        <td><a href="~/Content/leavefile/@row["attachfile"]"><i class="fa-solid fa-download" text-primary></i></a></td>
                        <td>@row["ISACCEPTED"]</td>
                    </tr>
                        i = i + 1;
                    }
                </tbody>
                </table>
            </div>
        </div>
    </div>

