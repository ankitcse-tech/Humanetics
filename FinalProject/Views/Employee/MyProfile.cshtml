
@{
    ViewBag.Title = "Employee Profile";
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
}
<style>
    .userimg {
        height: 120px;
        width: 120px;
        border-radius: 60%;
        border: 1px solid black;
    }
</style>

@foreach(System.Data.DataRow row in ViewBag.user.Rows)
{

<div class="container-fluid">
    <div class="row py-2">
        <p class="fs-3 text-center fw-semibold">
            Welcome to <b class="text-mycolor">Profile</b>
        </p>
        <div class="col-sm-8 mx-auto">
            <div class="row py-3">
                <div class="col-sm-8 mx-auto">
                    <div class="card mx-auto shadow-lg border border-0 rounded-4 mt-5 " style="min-height:400px;">
                        <img src="~/Content/profile/@row["PICTURE"]" class="img-fluid userimg position-absolute start-50 top-0 translate-middle" />
                        <h3 class="text-center" style="margin-top:70px;">@row["NAME"] </h3>
                        <p class="text-center m-0"><i class="fa-solid fa-envelope  text-primary "></i>@row["EMAILID"]</p>
                        <p class="text-center m-1"><i class="fa-solid fa-phone text-primary "></i>@row["MobNo"]</p>
                        <div class="row g-0 ps-3 pt-3">
                            <div class="col-3">
                                <i class="fa-solid fa-location  text-primary "></i> Address :
                            </div>
                            <div class="col-sm-9">
                                 @row["ADDRESS"]
                            </div>
                        </div>
                        <div class="row g-0 ps-3 pt-3">
                            <div class="col-sm-4">
                                <i class="fa fa-graduation-cap text-primary "></i> Education :
                            </div>
                            <div class="col-sm-9">
                                 @row["QUALIFICATION"]
                            </div>
                        </div>
                        <div class="row g-0 ps-3 pt-3">
                            <div class="col-sm-4">
                                <i class="fa fa-graduation-cap  text-primary "></i> Experience:
                            </div>
                            <div class="col-sm-9">
                                 @row["EXP"]
                            </div>
                        </div>
                        <div class="row g-0 ps-3 pt-3">
                            <div class="col-sm-4">
                                <i class="fa-solid fa-genderless text-primary "></i> Gender :
                            </div>
                            <div class="col-sm-9">
                                @row["GENDER"]
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
}
