
@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/_Employeelayout.cshtml";
}

<form method="post" enctype="multipart/form-data">
    <div class="container-fluid">
        <div class="row py-2">
            <div class="col-sm-12">
                <p class="fs-3 text-center fw-semibold fst-italic">
                    Change Your<b class="text-mycolor"> Password</b>
                </p>
                <hr class="mx-auto w-30" />
            </div>
            <!--ChangePassword form Start-->
            <div class="col-sm-4 mt-3 shadow p-3 mb-5 bg-white rounded mx-auto">
                <h4 class="text-center fw-semibold">Change Password</h4>
                <div class="form-floating mb-3">
                    <input type="text" name="opass" class="form-control" id="floatingopass" placeholder="name@example.com" />
                    <label for="floatingopass">Old Password</label>
                </div>


                <div class="form-floating mb-3">
                    <input type="text" name="npass" class="form-control" id="floatingnpass" placeholder="name@example.com" />
                    <label for="floatingnpass">New Password</label>
                </div>

                <div class="form-floating mb-3">
                    <input type="password" name="cpass" class="form-control" id="floatingcpass" placeholder="name@example.com" />
                    <label for="floatingcpass">Re-Enter Password</label>
                </div>

                <input type="submit" value="Change Password" class="btn btn-danger" />
            </div>
        </div>
    </div>
</form>
